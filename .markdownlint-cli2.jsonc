{
  "config": {
    "MD013": false,
    "MD033": false,
    "MD060": false,
    "MD024": { "siblings_only": true }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.venv/**",
    "client/**",
    "graph/**",
    "spoiler/**",
    "renderer/**",
    "contracts/**",
    "fixtures/**",
    "website/**"
  ]
}
